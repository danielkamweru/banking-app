# Banking App Environment Variables
# Copy this file to .env and fill in your values for local development

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://banking_user:password@localhost:5432/banking_app

# JWT Secret Key (generate a strong random string for production)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Admin email list (comma-separated for transaction notifications)
ADMIN_CC_LIST=admin1@example.com,admin2@example.com

# SMTP Configuration (for email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Application Settings
ENVIRONMENT=development
DEBUG=true
